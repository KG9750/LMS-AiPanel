{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src/server/**/*.ts", "src/domain/**/*.ts", "src/adapters/**/*.ts", "src/shared/**/*.ts", "src/storage/**/*.ts", "src/cli/**/*.ts"]
}
