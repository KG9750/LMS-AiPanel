{
  "name": "lms-aipanel",
  "version": "0.1.0",
  "description": "Localhost AI stack control plane for macOS AI tooling.",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KG9750/LMS-AiPanel.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KG9750/LMS-AiPanel/issues"
  },
  "homepage": "https://github.com/KG9750/LMS-AiPanel#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@tanstack/react-query": "^5.100.9",
    "@xyflow/react": "^12.10.2",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "fs-extra": "^11.3.5",
    "nanoid": "^5.1.11",
    "plist": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
